# aws
export AWS_ACCESS_KEY_ID=<アクセスキーの値>
export AWS_SECRET_ACCESS_KEY=<シークレットアクセスキーの値>
export AWS_DEFAULT_REGION=ap-northeast-1 # このまま
export AWS_ROLE_ARN='arn:aws:iam::<アカウントID>:role/ds-internship-2026-snowflake-role'
export AWS_MFA_SERIAL='arn:aws:iam::<アカウントID>:mfa/<MFAデバイス名>'
export AWS_ROLE_PROFILE_NAME='ds-internship-2026-snowflake-role' # このまま (AssumeRole 用プロファイル名)

# Snowflake（キーペア認証）
export SNOWFLAKE_USER='<your name>'
export SNOWFLAKE_AUTHENTICATOR='SNOWFLAKE_JWT' # このまま
# 秘密鍵（.p8）のパス。絶対パスで書く
export PRIVATE_KEY_FILE='<プライベートキーの絶対パス（例: /workspaces/ipj-internship-summer-work/rsa_key.p8）>'


# dbt
export TEAM_NAME='<チーム名を大文字アルファベットで、`TEAM_X`の形式（例: TEAM_A）>'
